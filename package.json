{
  "name": "globe-guess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "test": "node --test --experimental-strip-types src/shared/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply globe-guess --local",
    "db:migrate:remote": "wrangler d1 migrations apply globe-guess --remote",
    "data": "node scripts/build-countries.mjs",
    "test:protocol": "node tests/protocol.mjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:class": "node tests/class20.cjs"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "maplibre-gl": "^6.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
