{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-map-quiz",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // geomapquiz.com is the address teachers and students use; www redirects to it (a redirect
  // rule on the zone). The Access app protects geomapquiz.com/host and /api/host.
  "routes": [
    { "pattern": "geomapquiz.com", "custom_domain": true },
    { "pattern": "www.geomapquiz.com", "custom_domain": true }
  ],
  // One public address to share and protect: the old *.workers.dev URL is off.
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request so it can send www.geomapquiz.com to geomapquiz.com; it
    // handles /api/* itself and hands everything else to the React SPA via env.ASSETS.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "Party" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Party"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-map-quiz",
      // Replace with the id printed by: npx wrangler d1 create daily-map-quiz
      "database_id": "5888925c-e235-416a-afbb-c3fd6f279152",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access (Zero Trust) — see README "Protect the teacher side".
    // e.g. "https://your-team.cloudflareaccess.com"
    "TEAM_DOMAIN": "https://brians-team.cloudflareaccess.com",
    // Application Audience (AUD) tag of the Access application protecting /host and /api/host
    "POLICY_AUD": "437ff2acc447ce3ad6160d356057d4107b09015bd4737cf20d48d1dc22605b20"
  }
}
