{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-map-quiz",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker handles the API (incl. WebSockets); everything else is the React SPA.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "Party" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Party"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-map-quiz",
      // Replace with the id printed by: npx wrangler d1 create daily-map-quiz
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access (Zero Trust) — see README "Protect the teacher side".
    // e.g. "https://your-team.cloudflareaccess.com"
    "TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application protecting /host and /api/host
    "POLICY_AUD": ""
  }
}
